# ── App ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
API_BASE_URL=/api/v1
# Comma-separated list of exact origins allowed to make credentialed cross-origin requests.
# Not needed for the bundled frontend (served same-origin) — only matters for extra clients
# like a separate admin panel or mobile app. Never use '*' — invalid alongside credentials.
CORS_ORIGIN=http://localhost:4000

# ── Database (PostgreSQL via Prisma) ────────────────────────────
DATABASE_URL=postgresql://nexuscapital:nexuscapital@postgres:5432/nexuscapital?schema=public

# ── Redis (sessions, refresh-token allowlist, rate limiting) ────
REDIS_URL=redis://redis:6379

# ── JWT ──────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Password hashing ─────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── Flutterwave (MTN / Airtel / Card / Bank collections + payouts) ─
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_WEBHOOK_SECRET_HASH=change_this_webhook_hash_in_production
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# ── Rate limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Currency (base rates to USD; refreshed into Redis on boot) ──
DEFAULT_CURRENCY=USD
